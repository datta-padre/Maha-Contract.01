<%- include("Navbar.ejs") %>

<div class="container company-about-page">
    
    <div class="row company-title-panel p-3 bg-white rounded border shadow-sm mt-3">
        <div class="col-md-12">
            <h1 class="company-title fw-bold">About Company</h1>
            <p>Update : <%= formattedDate %></p>
        </div>
    </div>

    <form action="/masterAdmin/save_company" method="post">

    <div class="row company-form-panel bg-white p-3 rounded mt-4 border shadow-sm">

        <div class="col-md-4 fw-bold mt-2 mb-3">
            Company Name 
            <input class="form-control" type="text"  name="company_name" value="<%= about_company.company_name %>">
        </div>


        <div class="col-md-4 fw-bold mt-2 mb-3">
             Mobile
             <input class="form-control" type="tel"  name="company_mobile" value="<%= about_company.company_mobile %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
            Email 
            <input class="form-control" type="email"  name="company_email" value="<%= about_company.company_email %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
            WhatsApp No
            <input class="form-control" type="tel"  name="company_whatsapp" value="<%= about_company.company_mobile %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
           Instagram
           <input class="form-control" type="text"  name="instagram" value="<%= about_company.instagram %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
           YouTube 
           <input class="form-control" type="text" name="youtube" value="<%= about_company.youtube %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
           Facebook
           <input class="form-control" type="text"  name="facebook" value="<%= about_company.facebook %>">
        </div>

        <div class="col-md-4 fw-bold mt-2 mb-3">
           Twitter
           <input class="form-control" type="text"  name="twitter" value="<%= about_company.twitter %>">
        </div>

         <div class="col-md-4 fw-bold mt-2 mb-3">
           linkedIn
           <input class="form-control" type="text"  name="linkedin" value="<%= about_company.linkedin %>">
        </div>

        <div class="col-md-12 fw-bold mt-2 mb-3">
            Company Address 
            <textarea class="form-control" name="company_address" rows="8"><%= about_company.company_address %></textarea>
        </div>

         <div class="col-md-12 text-center mt-3">
            <button class="btn btn-primary px-4">Save Company</button>
        </div>

    </div>

    </form>

</div>

<%- include("Footer.ejs") %>