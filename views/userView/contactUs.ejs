<%- include('Navbar.ejs') %>

<main class="contact-page">
  <div class="contact-container">
    <header class="contact-heading">
      <span class="contact-heading-icon" aria-hidden="true"><i class="ri-message-2-line"></i></span>
      <div>
        <h1>Contact Us</h1>
        <p>Need help with your account, a tender, or a payment? Our team is here to help.</p>
      </div>
    </header>

    <section class="contact-info-grid" aria-label="Contact and support information">
      <a class="contact-info-card" href="mailto:<%= about_company.company_email %>" aria-label="Email us at <%= about_company.company_email %>">
        <i class="ri-mail-line contact-card-icon contact-email-icon" aria-hidden="true"></i>
        <h2>Email</h2>
        <span class="contact-card-link"><%= about_company.company_email %></span>
        <p>For account, tender, or payment questions.</p>
      </a>

      <a class="contact-info-card" href="https://wa.me/91<%= about_company.company_whatsapp %>" target="_blank" rel="noopener noreferrer" aria-label="Chat with support on WhatsApp">
        <i class="ri-whatsapp-line contact-card-icon contact-chat-icon" aria-hidden="true"></i>
        <h2>WhatsApp Support</h2>
        <span class="contact-card-link">+91 <%= about_company.company_whatsapp %></span>
        <p>Chat with us about login, profile, or verification.</p>
      </a>

      <a class="contact-info-card" href="tel:+91<%= about_company.company_mobile %>" aria-label="Call support at +91 <%= about_company.company_mobile %>">
        <i class="ri-phone-line contact-card-icon contact-phone-icon" aria-hidden="true"></i>
        <h2>Call Support</h2>
        <span class="contact-card-link">+91 <%= about_company.company_mobile %></span>
        <p>Call us between 10:00 AM and 6:00 PM.</p>
      </a>

      <a class="contact-info-card" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(about_company.company_address) %>" target="_blank" rel="noopener noreferrer" aria-label="View our location on Google Maps">
        <i class="ri-map-pin-2-line contact-card-icon contact-location-icon" aria-hidden="true"></i>
        <h2>Location</h2>
        <span class="contact-card-link"><%= about_company.company_address %></span>
        <p>Maharashtra, India · Open in Google Maps</p>
      </a>
    </section>

    <p class="contact-hint">For faster support, choose a topic and include the mobile number registered to your account.</p>

    <section class="contact-form-card" id="contact-form" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title">Send us a message</h2>
      <form action="/contact" method="POST" id="contactForm" aria-describedby="contactFormNote">
        <div class="contact-field">
          <label for="contactName">Your Name <span>*</span></label>
          <input id="contactName" name="name" type="text" autocomplete="name" placeholder="Enter your full name" required>
        </div>

        <div class="contact-field">
          <label for="contactPhone">Registered Mobile Number <span>*</span></label>
          <div class="contact-phone-input">
            <label class="sr-only" for="contactCountryCode">Country code</label>
            <select id="contactCountryCode" name="countryCode" aria-label="Country code">
              <option value="+91">IN +91</option>
            </select>
            <input id="contactPhone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="10-digit mobile number" pattern="[0-9]{10}" minlength="10" maxlength="10" title="Enter a 10-digit mobile number" required>
          </div>
        </div>

        <div class="contact-field">
          <label for="contactTopic">Topic <span>*</span></label>
          <select id="contactTopic" name="topic" required>
            <option value="" selected disabled>Select a topic</option>
            <option>Account or login</option>
            <option>Verification</option>
            <option>Tender or bidding</option>
            <option>Payment or subscription</option>
            <option>Technical issue</option>
            <option>Other</option>
          </select>
        </div>

        <div class="contact-field">
          <label for="contactMessage">Message <span>*</span></label>
          <textarea id="contactMessage" name="message" rows="6" placeholder="Describe your issue or question in detail..." required></textarea>
        </div>

        <button class="contact-submit" type="submit">
          <i class="ri-send-plane-line" aria-hidden="true"></i>
          Send message
        </button>
        <p class="contact-form-note" id="contactFormNote" aria-live="polite">Submitting opens your email app with the message details filled in. No message is sent or stored on this website.</p>
      </form>
    </section>
  </div>
</main>

<%- include('Footer.ejs') %>
